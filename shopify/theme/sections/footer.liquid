<footer><div><a class="logo" href="{{ routes.root_url }}">{{ section.settings.brand | escape }}</a><p>{{ section.settings.tagline | escape }}</p></div><div><a href="{{ routes.all_products_collection_url }}">La collection</a><a href="{{ routes.search_url }}">Rechercher</a>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Mon compte</a>{% endif %}</div><small>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}<br>La maison, autrement</small></footer>
{% schema %}
{"name":"Pied de page","settings":[{"type":"text","id":"brand","label":"Nom affiché","default":"ArtDecor"},{"type":"text","id":"tagline","label":"Signature","default":"Des pièces singulières. Une maison bien à vous."},{"type":"link_list","id":"menu","label":"Menu complémentaire"}]}
{% endschema %}
