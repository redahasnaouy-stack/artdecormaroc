{% assign featured = section.settings.collection | default: collections.all %}
<section class="collection" id="collection"><div class="section-top"><div class="eyebrow">LA COLLECTION — ARTDECOR</div><span>Des objets, beaucoup de personnalité.</span></div><div class="collection-title"><h2>{{ section.settings.heading | escape }}<br><em>{{ section.settings.accent | escape }}</em></h2><p>{{ section.settings.description | escape }}</p></div><div class="products">{% for product in featured.products limit: section.settings.limit %}{% render 'product-card', card_product: product %}{% else %}<div class="empty-state"><p>La collection arrive bientôt.</p>{% if request.design_mode %}<p>Ajoutez des produits dans Shopify, puis sélectionnez une collection dans cette section.</p>{% endif %}</div>{% endfor %}</div><div class="collection-bottom"><span class="collection-caption">Des objets à aimer. Des espaces à réinventer.</span><a class="text-link" href="{{ featured.url | default: routes.all_products_collection_url }}">Toute la collection <span class="icon-arrow" aria-hidden="true"></span></a></div></section>
{% schema %}
{"name":"Collection à la une","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"heading","label":"Titre","default":"Votre prochain"},{"type":"text","id":"accent","label":"Texte lavande","default":"coup de cœur."},{"type":"textarea","id":"description","label":"Description","default":"Une sélection pour donner du relief à votre quotidien."},{"type":"range","id":"limit","label":"Nombre de produits","min":4,"max":24,"step":4,"default":8}],"presets":[{"name":"Collection à la une"}]}
{% endschema %}
