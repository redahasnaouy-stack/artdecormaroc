<section class="collection search-page"><h1 class="page-heading">Votre prochaine <em>trouvaille.</em></h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><label for="SearchInput">Rechercher un produit</label><input id="SearchInput" name="q" type="search" value="{{ search.terms | escape }}" placeholder="Vase, miroir, luminaire…" required><input type="hidden" name="type" value="product"><button class="button dark" type="submit">Rechercher</button></form>{% if search.performed %}<p class="muted">{{ search.results_count }} résultat(s) pour « {{ search.terms | escape }} »</p>{% paginate search.results by 24 %}<div class="products">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', card_product: item %}{% endif %}{% else %}<p>Aucune pièce trouvée. Essayez une autre recherche.</p>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}{% endif %}</section>
{% schema %}{"name":"Recherche","settings":[]}{% endschema %}
