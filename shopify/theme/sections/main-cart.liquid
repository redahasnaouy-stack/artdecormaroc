<section class="page-shell cart-page"><div class="eyebrow">VOS PIÈCES PRÉFÉRÉES</div><h1 class="page-heading">Votre <em>panier.</em></h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post" id="CartForm"><div class="cart-lines">{% for item in cart.items %}<div class="cart-row">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}</a>{% endif %}<div><h2 class="cart-item-title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.product.has_only_default_variant %}<p class="muted">{{ item.variant.title | escape }}</p>{% endunless %}{% for property in item.properties %}{% assign property_first = property.first | slice: 0 %}{% if property.last != blank and property_first != '_' %}<p class="muted">{{ property.first | escape }} : {{ property.last | escape }}</p>{% endif %}{% endfor %}{% for allocation in item.line_level_discount_allocations %}<p class="muted">{{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})</p>{% endfor %}<label for="Quantity-{{ item.key }}">Quantité<input type="number" name="updates[]" id="Quantity-{{ item.key }}" value="{{ item.quantity }}" min="0" step="1" required></label><a class="text-link" href="{{ item.url_to_remove }}">Retirer</a></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><div class="cart-summary">{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} : −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<div class="totals"><span>Sous-total</span><strong>{{ cart.total_price | money }}</strong></div><p class="muted">Livraison et taxes éventuelles calculées au paiement.</p><label for="CartNote">Une précision pour votre commande ?<textarea name="note" id="CartNote">{{ cart.note | escape }}</textarea></label><button class="button" name="update" type="submit">Mettre à jour le panier</button><button class="button dark" type="submit" name="checkout">Passer la commande <span class="icon-arrow" aria-hidden="true"></span></button></div></form>{% else %}<p>Votre panier attend votre prochain coup de cœur.</p><a class="button dark" href="{{ routes.all_products_collection_url }}">Découvrir la collection</a>{% endif %}</section>
{% schema %}{"name":"Panier","settings":[]}{% endschema %}
