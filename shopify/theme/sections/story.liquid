<section class="story" id="inspiration"><div class="story-image">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480, 720, 1000, 1400', sizes: '(max-width: 580px) 90vw, 48vw', loading: 'lazy' }}{% else %}<img src="{{ 'interior.jpg' | asset_url }}" width="1400" height="1050" loading="lazy" alt="Salon chaleureux aux lignes naturelles">{% endif %}<span>LA BEAUTÉ EST DANS LES DÉTAILS.</span></div><div class="story-copy"><div class="eyebrow">L’ESPRIT ARTDECOR</div><h2>{{ section.settings.heading | escape }}<br><em>{{ section.settings.accent | escape }}</em></h2><p>{{ section.settings.text | escape }}</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Entrez dans notre univers <span class="icon-arrow" aria-hidden="true"></span></a></div></section>
{% schema %}
{"name":"Notre univers","settings":[{"type":"image_picker","id":"image","label":"Photo"},{"type":"text","id":"heading","label":"Titre","default":"Pas juste un lieu."},{"type":"text","id":"accent","label":"Texte lavande","default":"Votre univers."},{"type":"textarea","id":"text","label":"Texte","default":"On aime les objets qui réchauffent une pièce. Ceux qu’on garde, qu’on déplace, qu’on redécouvre. Notre envie : vous aider à composer un chez-vous singulier, à votre rythme."}],"presets":[{"name":"Notre univers"}]}
{% endschema %}
