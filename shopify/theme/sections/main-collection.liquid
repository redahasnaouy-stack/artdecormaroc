<section class="collection"><div class="eyebrow">ARTDECOR — LA COLLECTION</div><div class="collection-title"><h1 class="page-heading">{{ collection.title | escape }}</h1><div class="rte">{{ collection.description }}</div></div><div class="catalog-tools"><a class="text-link" href="{{ routes.search_url }}">Rechercher une pièce</a><form action="{{ collection.url }}" method="get"><label for="SortBy">Trier les produits</label><select name="sort_by" id="SortBy">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><button class="button dark" type="submit">Appliquer</button></form></div><p class="muted">{{ collection.products_count }} produits</p>{% paginate collection.products by 24 %}<div class="products">{% for product in collection.products %}{% render 'product-card', card_product: product %}{% else %}<p>Aucun produit dans cette collection.</p>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>
{% schema %}{"name":"Page collection","settings":[]}{% endschema %}
