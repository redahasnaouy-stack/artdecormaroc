{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pages">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Précédent</a>{% endif %}{% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% elsif part.title == paginate.current_page %}<span aria-current="page">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}{% endfor %}{% if paginate.next %}<a href="{{ paginate.next.url }}">Suivant →</a>{% endif %}</nav>{% endif %}
