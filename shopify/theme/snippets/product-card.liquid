{% assign card_alt = card_product.featured_image.alt | default: card_product.title %}
<article class="product-card">
  <div class="product-image"><a href="{{ card_product.url }}" aria-label="Découvrir {{ card_product.title | escape }}">{% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 800 | image_tag: widths: '240, 400, 600, 800', sizes: '(max-width: 850px) 45vw, 23vw', loading: 'lazy', alt: card_alt }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</a>{% if card_product.type != blank %}<span class="tag">{{ card_product.type | escape }}</span>{% endif %}</div>
  <div class="product-body"><div class="product-category">{{ card_product.type | default: card_product.vendor | escape }}</div><h3 class="product-name"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3><div class="product-meta"><strong>{% if card_product.price_varies %}Dès {% endif %}{{ card_product.price | money }}</strong>{% unless card_product.available %}<span class="muted">Épuisé</span>{% endunless %}</div><a class="product-details" href="{{ card_product.url }}"><span>Voir le produit</span><span class="icon-arrow" aria-hidden="true"></span></a></div>
</article>
